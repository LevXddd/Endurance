#include "exc.h"
#include <cmath>
#include <cstdlib>
#include <iostream>
int gettingInputFromUser(double &a, double &b, double &c) {
  std::cout << "Enter data(a,b,c): ";
  std::cin >> a >> b >> c;
  return EXIT_SUCCESS;
}

bool checkingA(const double a) {
  if (a == 0) {
    std::cout << "Access is denied. Write again correct a.\n";
    return false;
  } else {
    std::cout << "Access is granted.\n";
    return true;
  }
}

int checkingDisc(const double a, const double b, const double c) {
  if (checkingA(a) == true) {
    double x{pow(b, 2) - (4 * a * c)};
    double z((-b + sqrt(x)) / (2 * a));
    double y((-b - sqrt(x)) / (2 * a));
    std::cout << "The discriminant will be: " << x << '\n';
    if (x < 0) {
      std::cout << "There are not roots. \n";
      return EXIT_FAILURE;
    } else if (x == 0) {
      std::cout << "There is one root(maximum/minimal vertex): " << z << '\n';
      return EXIT_SUCCESS;
    } else {
      std::cout << "There are two roots: " << z << " " << y << "\n";
      return EXIT_SUCCESS;
    }
  }
  return EXIT_FAILURE;
}

int main() {
  double a{};
  double b{};
  double c{};
  gettingInputFromUser(a, b, c);
  checkingDisc(a, b, c);
  return EXIT_SUCCESS;
}
